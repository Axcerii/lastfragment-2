// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Race {
  Humain
  Geant      @map("Géant")
  Eternelle  @map("Éternelle")
  Inconnu
  Dragon
  Ange
}

enum Country {
  Augeaime
  Inconnu
  Irisia
  Amari
  Mudan
  Edenia
  Celeste   @map("Céleste")
  Saxifra
}

enum ItemCategory {
  Casque
  Torse
  Gantelets
  Jambieres  @map("Jambières")
  Outil
  Arme
  Fiole
  Nourriture
  Munitions
  Important
  Autre
  Materiaux  @map("Matériaux")
  Animal
  Sac
}

enum FoodType {
  viandes
  boissons
  fruits
  rations
}

enum BadgeType {
  Artrish
  Yinva
  Guizamark
  Shizari
  Pestia
  Chronos
  Aqua
  Goliath
  Drii
  Lada
  Pura
}

enum SkillStatistic {
  PV
  QDF
  Endurance
  Maitrise   @map("Maîtrise")
  Force
  Defense    @map("Défense")
  Vitesse
  Precision  @map("Précision")
  Perception
  Furtivite  @map("Furtivité")
  Charisme
  Eloquence  @map("Éloquence")
  Intelligence
}

model Player {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  login        String  @unique @db.VarChar(255)
  password     String  @db.VarChar(255)
  role         BigInt  @db.BigInt
  team         BigInt  @db.BigInt
  characterId  BigInt? @map("character_id") @db.UnsignedBigInt
  
  // Relations
  character    Character?        @relation(fields: [characterId], references: [id])
  itemsInPlayer ItemInPlayer[]
  badgesFusions BadgeFusion[]
  
  @@index([characterId], map: "players_character_id_index")
  @@map("players")
}

model Character {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  visibility  Int      @db.SmallInt
  name        String   @db.VarChar(255)
  flux        String?  @db.VarChar(255)
  dragon      String   @db.VarChar(255)
  title       String?  @db.VarChar(255)
  theme       String?  @db.VarChar(255)
  race        Race
  country     Country
  image       String   @db.VarChar(255)
  description String   @db.Text
  category    String   @db.VarChar(255)
  current     Int      @db.SmallInt
  
  // Relations
  players     Player[]
  statistics  Statistic[]
  passives    Passive[]
  
  @@map("characters")
}

model Monster {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  visibility   Int     @db.SmallInt
  name         String  @db.VarChar(255)
  dragon       String  @db.VarChar(255)
  size         String  @db.VarChar(255)
  weight       String  @db.VarChar(255)
  dangerosity  BigInt  @db.BigInt
  image        String  @db.VarChar(255)
  effect       String  @db.Text
  description  String  @db.Text
  current      Int     @db.SmallInt
  
  @@map("monsters")
}

model Statistic {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  characterId BigInt @map("character_id") @db.UnsignedBigInt
  qdf         BigInt @db.BigInt
  pv          BigInt @db.BigInt
  endurance   BigInt @db.BigInt
  strength    BigInt @db.BigInt
  maitrise    BigInt @db.BigInt
  defense     BigInt @db.BigInt
  vitesse     BigInt @db.BigInt
  accuracy    BigInt @db.BigInt
  perception  BigInt @db.BigInt
  furtivite   BigInt @db.BigInt
  charisme    BigInt @db.BigInt
  eloquence   BigInt @db.BigInt
  intelligence BigInt @db.BigInt
  
  // Relations
  character   Character @relation(fields: [characterId], references: [id])
  
  @@index([characterId], map: "statistics_character_id_index")
  @@map("statistics")
}

model Item {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  category    ItemCategory
  rarity      BigInt       @db.BigInt
  weight      BigInt       @db.BigInt
  description String       @db.Text
  
  // Relations
  itemsInPlayer ItemInPlayer[]
  armors        Armor[]
  
  @@map("items")
}

model ItemInPlayer {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  itemId       BigInt @map("item_id") @db.UnsignedBigInt
  playerId     BigInt @map("player_id") @db.UnsignedBigInt
  localisation String @db.VarChar(255)
  
  // Relations
  item         Item              @relation(fields: [itemId], references: [id])
  player       Player            @relation(fields: [playerId], references: [id])
  armorInPlayer ArmorInPlayer[]
  foodsInBags  FoodInBag[]
  
  @@map("items_in_player")
}

model Armor {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name       String @db.VarChar(255)
  statistics String @db.VarChar(255)
  values     String @db.VarChar(255)
  itemId     BigInt @map("item_id") @db.UnsignedBigInt
  
  // Relations
  item       Item            @relation(fields: [itemId], references: [id])
  armorInPlayer ArmorInPlayer[]
  
  @@map("armors")
}

model ArmorInPlayer {
  id               BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  itemInPlayerId   BigInt @map("item_in_player_id") @db.UnsignedBigInt
  armorId          BigInt @map("armor_id") @db.UnsignedBigInt
  statistics       String @db.VarChar(255)
  values           String @db.VarChar(255)
  descriptionAdd   BigInt @map("description_add") @db.BigInt
  notes            String @db.Text
  
  // Relations
  itemInPlayer     ItemInPlayer @relation(fields: [itemInPlayerId], references: [id])
  armor            Armor        @relation(fields: [armorId], references: [id])
  
  @@map("armors_in_player")
}

model Food {
  id     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name   String   @db.VarChar(255)
  weight BigInt   @db.BigInt
  type   FoodType
  price  BigInt   @db.BigInt
  
  // Relations
  foodsInBags FoodInBag[]
  
  @@map("foods")
}

model FoodInBag {
  id             BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  itemInPlayerId BigInt @map("item_in_player_id") @db.UnsignedBigInt
  foodId         BigInt @map("food_id") @db.UnsignedBigInt
  
  // Relations
  itemInPlayer   ItemInPlayer @relation(fields: [itemInPlayerId], references: [id])
  food           Food         @relation(fields: [foodId], references: [id])
  
  @@map("foods_in_bags")
}

model Badge {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  badges      String @db.VarChar(255)
  name        String @db.VarChar(255)
  description String @db.Text
  
  @@map("badges")
}

model BadgeFusion {
  id       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  badge1   BadgeType @map("badge_1")
  badge2   BadgeType @map("badge_2")
  playerId BigInt    @map("player_id") @db.UnsignedBigInt
  
  // Relations
  player   Player    @relation(fields: [playerId], references: [id])
  
  @@map("badges_fusions")
}

model Skill {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  statistics  SkillStatistic
  name        String         @db.VarChar(255)
  description String         @db.Text
  level       BigInt         @db.BigInt
  
  @@map("skills")
}

model Passive {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  characterId BigInt @map("character_id") @db.UnsignedBigInt
  statistics  String @db.VarChar(255)
  maths       String @db.VarChar(255)
  
  // Relations
  character   Character @relation(fields: [characterId], references: [id])
  
  @@map("passives")
}