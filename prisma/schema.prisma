// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Race {
  Humain
  Geant     @map("Géant")
  Eternelle @map("Éternelle")
  Inconnu
  Dragon
  Ange
}

enum Country {
  Augeaime
  Inconnu
  Irisia
  Amari
  Mudan
  Edenia
  Celeste  @map("Céleste")
  Saxifra
}

enum ItemCategory {
  Casque
  Torse
  Gantelets
  Jambieres  @map("Jambières")
  Outil
  Arme
  Fiole
  Nourriture
  Munitions
  Important
  Autre
  Materiaux  @map("Matériaux")
  Animal
  Sac
}

enum FoodType {
  viandes
  boissons
  fruits
  rations
}

enum BadgeType {
  Artrish
  Yinva
  Guizamark
  Shizari
  Pestia
  Chronos
  Aqua
  Goliath
  Drii
  Lada
  Pura
}

enum SkillStatistic {
  PV
  QDF
  Endurance
  Maitrise     @map("Maîtrise")
  Force
  Defense      @map("Défense")
  Vitesse
  Precision    @map("Précision")
  Perception
  Furtivite    @map("Furtivité")
  Charisme
  Eloquence    @map("Éloquence")
  Intelligence
}

model Player {
  id          Int    @id @default(autoincrement())
  login       String @unique @db.VarChar(255)
  password    String @db.VarChar(255)
  role        Int    @db.Int
  team        Int    @db.Int
  characterId Int?   @map("character_id")
  money       Int    @default(0) @db.Int

  // Relations
  character      Character?     @relation(fields: [characterId], references: [id])
  itemsInPlayer  ItemInPlayer[]
  badgesFusions  BadgeFusion[]
  badges         PlayerBadge[]
  drafts         Draft[]
  dleGames       DleGame[]
  // Cartes à collectionner
  cards          Card[]
  cardWallet     CardWallet?
  cardOpenings   CardOpening[]
  cardEventsFrom CardEvent[]    @relation("CardEventFrom")
  cardEventsTo   CardEvent[]    @relation("CardEventTo")
  tradesSent     CardTrade[]    @relation("CardTradeFrom")
  tradesReceived CardTrade[]    @relation("CardTradeTo")

  @@index([characterId], map: "players_character_id_index")
  @@map("players")
}

model Character {
  id          Int     @id @default(autoincrement())
  visibility  Int     @db.SmallInt
  name        String  @db.VarChar(255)
  flux        String? @db.VarChar(255)
  job         String? @db.VarChar(255)
  dragon      String  @db.VarChar(255)
  title       String? @db.VarChar(255)
  theme       String? @db.VarChar(255)
  race        Race
  country     Country
  // Sans portrait, la silhouette par défaut est affichée
  image       String? @db.VarChar(255)
  description String  @db.Text
  category    String  @db.VarChar(255)
  current     Int     @db.SmallInt
  dead        Boolean @default(false)
  // Fiche « teaser » : visible dans la liste mais contenu masqué pour les joueurs
  censored    Boolean @default(false)
  quote       String? @db.VarChar(400)
  // Armure choisie par le MJ (ids de `armors`, une par emplacement), sans passer par un inventaire
  armorIds    Json?   @map("armor_ids")

  // Relations
  players         Player[]
  statistics      Statistic?
  passives        Passive[]
  characterSkills CharacterSkill[]
  dleDays         DleDay[]

  @@map("characters")
}

model Monster {
  id          Int    @id @default(autoincrement())
  visibility  Int    @db.SmallInt
  name        String @db.VarChar(255)
  dragon      String @db.VarChar(255)
  size        String @db.VarChar(255)
  weight      String @db.VarChar(255)
  dangerosity Int    @db.Int
  image       String @db.VarChar(255)
  effect      String @db.Text
  description String @db.Text
  current     Int    @db.SmallInt
  // Armure choisie par le MJ (ids de `armors`, une par emplacement)
  armorIds    Json?  @map("armor_ids")

  // Relations
  statistics Statistic?

  @@map("monsters")
}

model Statistic {
  id           Int  @id @default(autoincrement())
  characterId  Int? @unique @map("character_id")
  monsterId    Int? @unique @map("monster_id")
  qdf          Int  @db.Int
  pv           Int  @db.Int
  endurance    Int  @db.Int
  strength     Int  @db.Int
  maitrise     Int  @db.Int
  defense      Int  @db.Int
  vitesse      Int  @db.Int
  accuracy     Int  @db.Int
  perception   Int  @db.Int
  furtivite    Int  @db.Int
  charisme     Int  @db.Int
  eloquence    Int  @db.Int
  intelligence Int  @db.Int

  // Relations
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monster   Monster?   @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@map("statistics")
}

model Item {
  id          Int          @id @default(autoincrement())
  name        String       @default("Objet") @db.VarChar(255)
  category    ItemCategory
  rarity      Int          @db.Int
  weight      Int          @db.Int
  description String       @db.Text
  // Icône personnalisée ; à défaut, l'icône de la catégorie est utilisée
  icon        String?      @db.VarChar(255)
  // Bonus propres d'une arme, codes séparés par des virgules (« ignore-defense:5 ») — voir game/weapons.ts.
  // Ses bonus de stats, eux, passent par `armors` comme pour une armure.
  weaponBonus String?      @map("weapon_bonus") @db.VarChar(255)

  // Relations
  itemsInPlayer ItemInPlayer[]
  armors        Armor[]

  @@map("items")
}

model ItemInPlayer {
  id           Int     @id @default(autoincrement())
  itemId       Int     @map("item_id")
  // null = objet du coffre commun
  playerId     Int?    @map("player_id")
  quantity     Int     @default(1) @db.Int
  localisation String  @db.VarChar(255)
  equipped     Boolean @default(false)
  // Arme équipée : "gauche", "droite" ou "deux" (deux mains). Null pour tout le reste.
  hand         String? @db.VarChar(10)

  // Relations
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  player        Player?         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  armorInPlayer ArmorInPlayer[]
  foodsInBags   FoodInBag[]

  @@map("items_in_player")
}

model Armor {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(255)
  statistics String @db.VarChar(255)
  values     String @db.VarChar(255)
  itemId     Int    @map("item_id")

  // Relations
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  armorInPlayer ArmorInPlayer[]

  @@map("armors")
}

model ArmorInPlayer {
  id             Int    @id @default(autoincrement())
  itemInPlayerId Int    @map("item_in_player_id")
  armorId        Int    @map("armor_id")
  statistics     String @db.VarChar(255)
  values         String @db.VarChar(255)
  descriptionAdd String @map("description_add") @db.VarChar(255)
  notes          String @db.Text

  // Relations
  itemInPlayer ItemInPlayer @relation(fields: [itemInPlayerId], references: [id], onDelete: Cascade)
  armor        Armor        @relation(fields: [armorId], references: [id], onDelete: Cascade)

  @@map("armors_in_player")
}

model Food {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  weight Int      @db.Int
  type   FoodType
  price  Int      @db.Int

  // Relations
  foodsInBags FoodInBag[]

  @@map("foods")
}

model FoodInBag {
  id             Int @id @default(autoincrement())
  itemInPlayerId Int @map("item_in_player_id")
  foodId         Int @map("food_id")
  quantity       Int @default(1) @db.Int

  // Relations
  itemInPlayer ItemInPlayer @relation(fields: [itemInPlayerId], references: [id], onDelete: Cascade)
  food         Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@map("foods_in_bags")
}

model Badge {
  id          Int    @id @default(autoincrement())
  badges      String @db.VarChar(255)
  name        String @db.VarChar(255)
  description String @db.Text

  @@map("badges")
}

// Jeton de badge distribué par le MJ, consommé lors d'une fusion
model PlayerBadge {
  id       Int       @id @default(autoincrement())
  playerId Int       @map("player_id")
  badge    BadgeType
  used     Boolean   @default(false)

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_badges")
}

model BadgeFusion {
  id       Int       @id @default(autoincrement())
  badge1   BadgeType @map("badge_1")
  badge2   BadgeType @map("badge_2")
  playerId Int       @map("player_id")

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("badges_fusions")
}

model Skill {
  id              Int              @id @default(autoincrement())
  statistics      SkillStatistic
  name            String           @db.VarChar(255)
  description     String           @db.Text
  level           Int              @db.Int
  characterSkills CharacterSkill[]

  @@map("skills")
}

model CharacterSkill {
  id          Int @id @default(autoincrement())
  characterId Int @map("character_id")
  skillId     Int @map("skill_id")
  level       Int @default(1) @db.Int

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillId], map: "character_skills_character_skill_unique")
  @@map("character_skills")
}

model Passive {
  id            Int     @id @default(autoincrement())
  characterId   Int     @map("character_id")
  name          String  @default("") @db.VarChar(255)
  description   String? @db.Text
  active        Boolean @default(true)
  statistics    String  @db.VarChar(255)
  maths         String  @db.VarChar(255)
  // Effet appliqué quand le passif est désactivé (même format que maths), optionnel
  inactiveMaths String? @map("inactive_maths") @db.VarChar(255)

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("passives")
}

// Ligne unique (id = 1) : conteneurs d'inventaire accessibles aux joueurs
model GameState {
  id         Int     @id @default(1)
  mainOpen   Boolean @default(true) @map("main_open")
  bagOpen    Boolean @default(true) @map("bag_open")
  chestOpen  Boolean @default(true) @map("chest_open")
  horseOpen  Boolean @default(true) @map("horse_open")
  commonOpen Boolean @default(true) @map("common_open")

  @@map("game_state")
}

// Personnage ou monstre proposé depuis le créateur, en attente de validation par le MJ.
// Validé, il est recopié dans `characters` ou `monsters` puis supprimé d'ici.
model Draft {
  id          Int      @id @default(autoincrement())
  // "personnage" ou "monstre"
  kind        String   @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String   @db.Text
  image       String?  @db.VarChar(255)
  // Pseudo libre de l'auteur ; le compte est aussi gardé s'il était connecté
  author      String?  @db.VarChar(100)
  playerId    Int?     @map("player_id")
  // Les 13 stats, mêmes clés que la table `statistics`
  stats       Json
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@map("drafts")
}

// ─── Table de jeu (outil JDR en ligne) ───────────────────────────────────────

// Une partie menée par le MJ. Les joueurs la rejoignent depuis Outils quand elle est ouverte.
model TableSession {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  open         Boolean  @default(false)
  // Scène montrée aux joueurs
  sceneId      Int?     @map("scene_id")
  // Clé secrète de la vue OBS, partagée par lien
  obsKey       String   @map("obs_key") @db.VarChar(64)
  combat       Boolean  @default(false)
  // Ordre de passage (ids de jetons), affiché aux joueurs si `orderVisible`
  order        Json
  orderVisible Boolean  @default(false) @map("order_visible")
  turn         Int?
  // Image montrée en plein écran à tous les joueurs
  showcase     String?  @db.VarChar(255)
  // Piste en cours : { url, name, loop, playing, startedAt, offset }
  music        Json?
  // Ambiances superposées : [{ id, url, name, volume }]
  ambiences    Json
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  scenes TableScene[]
  tokens TableToken[]
  logs   TableLog[]

  @@map("table_sessions")
}

model TableScene {
  id          Int     @id @default(autoincrement())
  sessionId   Int     @map("session_id")
  name        String  @db.VarChar(255)
  background  String? @db.VarChar(255)
  cols        Int     @default(24)
  rows        Int     @default(16)
  gridVisible Boolean @default(true) @map("grid_visible")
  fogEnabled  Boolean @default(false) @map("fog_enabled")
  // Indices des cases révélées (y * cols + x)
  fog         Json
  // Effets posés sur le fond : teinte, météo animée, calque (gif/webm) — voir SceneEffects
  effects     Json?
  // Musique lancée automatiquement quand la scène est montrée
  musicUrl    String? @map("music_url") @db.VarChar(255)
  musicName   String? @map("music_name") @db.VarChar(255)
  sortOrder   Int     @default(0) @map("sort_order")

  // Relations
  session  TableSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokens   TableToken[]
  drawings TableDrawing[]

  @@index([sessionId])
  @@map("table_scenes")
}

model TableToken {
  id         Int     @id @default(autoincrement())
  sessionId  Int     @map("session_id")
  sceneId    Int?    @map("scene_id")
  // "player", "character", "monster" ou "custom"
  kind       String  @db.VarChar(20)
  playerId   Int?    @map("player_id")
  // Personnage ou monstre d'origine
  refId      Int?    @map("ref_id")
  name       String  @db.VarChar(255)
  image      String? @db.VarChar(255)
  // "ally", "enemy" ou "neutral"
  side       String  @default("enemy") @db.VarChar(10)
  x          Int     @default(0)
  y          Int     @default(0)
  size       Int     @default(1)
  // Invisible des joueurs
  hidden     Boolean @default(false)
  // Nom remplacé par « ??? » pour les joueurs
  nameHidden Boolean @default(false) @map("name_hidden")
  // Stats visibles des joueurs
  revealed   Boolean @default(false)
  // Stats finales (base + armure + passifs) et part due à l'armure, clés de `statistics`
  stats      Json
  armor      Json
  // Jauges actuelles, en points bruts (le maximum est dans `stats`)
  pv         Int     @default(0)
  qdf        Int     @default(0)
  endurance  Int     @default(0)

  // Relations
  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scene   TableScene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("table_tokens")
}

// Journal de la partie : jets, attaques, messages, événements
model TableLog {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  // "roll", "stat", "opposed", "attack", "chat", "system", "alert"
  kind      String   @db.VarChar(20)
  author    String   @db.VarChar(255)
  playerId  Int?     @map("player_id")
  // Visible du MJ seulement
  hidden    Boolean  @default(false)
  text      String   @db.Text
  // Détail chiffré : `detail` pour le MJ, `publicDetail` pour les joueurs
  data      Json?
  undone    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("table_logs")
}

// Bibliothèque de médias du MJ, partagée entre les parties
model TableAsset {
  id        Int      @id @default(autoincrement())
  // "fond", "jeton", "image", "calque", "musique", "ambiance", "effet"
  kind      String   @db.VarChar(20)
  name      String   @db.VarChar(255)
  url       String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("table_assets")
}

// Trait dessiné à main levée sur une scène, par un joueur ou le MJ
model TableDrawing {
  id        Int      @id @default(autoincrement())
  sceneId   Int      @map("scene_id")
  playerId  Int?     @map("player_id")
  author    String   @db.VarChar(255)
  color     String   @db.VarChar(9)
  width     Int      @default(4)
  // Coordonnées du plateau à plat : [x1, y1, x2, y2, …]
  points    Json
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  scene TableScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@map("table_drawings")
}

// ─── Lastdle ─────────────────────────────────────────────────────────────

// Personnage à deviner, fixé au premier passage du jour : le même pour tous jusqu'à minuit,
// même si le MJ modifie la liste des personnages entre-temps.
model DleDay {
  // Date à Paris, AAAA-MM-JJ
  date        String @id @db.VarChar(10)
  characterId Int    @map("character_id")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("dle_days")
}

// Partie du jour d'un joueur connecté : ses essais, et l'heure où il a trouvé.
model DleGame {
  id        Int       @id @default(autoincrement())
  playerId  Int       @map("player_id")
  date      String    @db.VarChar(10)
  // Ids des personnages proposés, dans l'ordre
  guesses   Json
  solvedAt  DateTime? @map("solved_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([date])
  @@map("dle_games")
}

// ─── Cartes à collectionner ──────────────────────────────────────────────

// Série de cartes : une bannière de boosters, avec sa numérotation (« 012/120 »).
// Le booster « All » pioche dans toutes les cartes publiées marquées `inAll`, séries ou non.
model CardSet {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(80)
  // Code imprimé au verso des cartes (« ARC1 »)
  code        String    @db.VarChar(8)
  description String?   @db.VarChar(400)
  logo        String?   @db.VarChar(255)
  // Visuel de la bannière, et couleur d'accent du booster
  banner      String?   @db.VarChar(255)
  color       String    @default("#e5b8cc") @db.VarChar(7)
  // Booster proposé aux joueurs ; `startsAt` / `endsAt` bornent une bannière temporaire
  active      Boolean   @default(false)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  templates CardTemplate[]
  openings  CardOpening[]
  packs     CardPack[]
  // Cartes d'autres séries (ou hors série) qui tombent aussi de ce booster
  extras    CardTemplateBooster[]

  @@map("card_sets")
}

// Paquet de booster d'une série : plusieurs illustrations pour un même contenu. Le joueur choisit
// celui qui lui plaît, ça ne change rien aux cartes tirées.
model CardPack {
  id        Int      @id @default(autoincrement())
  // null = booster « All »
  setId     Int?     @map("set_id")
  name      String   @db.VarChar(60)
  // Illustration de toute la face avant ; les textes du site ne s'y ajoutent que si `showText`
  image     String?  @db.VarChar(255)
  showText  Boolean  @default(false) @map("show_text")
  color     String   @default("#e5b8cc") @db.VarChar(7)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  set      CardSet?      @relation(fields: [setId], references: [id], onDelete: Cascade)
  openings CardOpening[]

  @@index([setId])
  @@map("card_packs")
}

// Modèle de carte dessiné par le MJ. Chaque exemplaire tiré est une ligne de `cards`.
model CardTemplate {
  id         Int      @id @default(autoincrement())
  setId      Int?     @map("set_id")
  // Numéro dans la série (« 012 »), unique dans la série
  number     Int?
  // "personnage", "monstre", "arme", "objet", "lieu", "dragon", "evenement" — voir cards/types.ts
  type       String   @db.VarChar(20)
  // 1 Commun · 2 Singulier · 3 Rare · 4 Légendaire · 5 Unique
  rarity     Int      @db.TinyInt
  name       String   @db.VarChar(60)
  // "brouillon" (MJ seul), "publiee" (tombe des boosters), "retiree" (ne tombe plus, reste possédée)
  status     String   @default("brouillon") @db.VarChar(12)
  // Tombe aussi du booster « All »
  inAll      Boolean  @default(true) @map("in_all")
  // Poids de tirage parmi les cartes de même rareté (10 = normal)
  weight     Int      @default(10)
  // Tirage limité : null = illimité. `printed` compte les exemplaires créés (= dernier n° de série).
  maxPrints  Int?     @map("max_prints")
  printed    Int      @default(0)
  // Recto, verso et finition : voir CardFace dans cards/types.ts, nettoyé par server/cards/face.ts
  face       Json
  // Fiche d'origine, pour reprendre ses données (personnage, monstre, objet)
  sourceKind String?  @map("source_kind") @db.VarChar(12)
  sourceId   Int?     @map("source_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  set      CardSet?              @relation(fields: [setId], references: [id], onDelete: Restrict)
  copies   Card[]
  // Boosters d'autres séries d'où la carte tombe aussi (cartes génériques, « énergies »)
  boosters CardTemplateBooster[]

  @@unique([setId, number])
  @@index([status])
  @@map("card_templates")
}

// Exemplaire possédé. Il n'est jamais supprimé par le jeu : retiré par le MJ, il passe à `ownerId` null.
// Booster supplémentaire d'un modèle : il tombe aussi des boosters de cette série, sans en faire
// partie (ni numéro ni case dans son album). Sa propre série reste `CardTemplate.setId`.
model CardTemplateBooster {
  templateId Int @map("template_id")
  setId      Int @map("set_id")

  // Relations
  template CardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  set      CardSet      @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([templateId, setId])
  @@index([setId])
  @@map("card_template_boosters")
}

model Card {
  id         Int      @id @default(autoincrement())
  templateId Int      @map("template_id")
  ownerId    Int?     @map("owner_id")
  // N° de série dans le modèle (#12, ou #12/50 si tirage limité)
  serial     Int
  // Usure de 0 (neuve) à 1 (marquée par le combat), tirée à la création
  wear       Float    @db.Double
  // "booster", "mj"
  origin     String   @db.VarChar(10)
  pinned     Boolean  @default(false)
  obtainedAt DateTime @default(now()) @map("obtained_at")

  // Relations
  template CardTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  owner    Player?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events   CardEvent[]
  trades   CardTradeItem[]

  @@unique([templateId, serial])
  @@index([ownerId])
  @@map("cards")
}

// Historique d'un exemplaire : tirage, échange, don ou retrait par le MJ
model CardEvent {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  // "tirage", "don", "echange", "transfert", "retrait"
  kind      String   @db.VarChar(10)
  fromId    Int?     @map("from_id")
  toId      Int?     @map("to_id")
  tradeId   Int?     @map("trade_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  card Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  from Player? @relation("CardEventFrom", fields: [fromId], references: [id], onDelete: SetNull)
  to   Player? @relation("CardEventTo", fields: [toId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@map("card_events")
}

// Réserve de boosters d'un joueur. Le stock se recalcule à la lecture (pas de tâche planifiée) :
// un booster de plus par intervalle écoulé depuis `since`, jusqu'au maximum.
model CardWallet {
  playerId Int      @id @map("player_id")
  stock    Int
  since    DateTime
  opened   Int      @default(0)

  // Relations
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("card_wallets")
}

// Booster ouvert : quelle série, quand, et les exemplaires obtenus
model CardOpening {
  id        Int       @id @default(autoincrement())
  playerId  Int       @map("player_id")
  // null = booster « All »
  setId     Int?      @map("set_id")
  // Paquet choisi (purement visuel), null pour le paquet par défaut
  packId    Int?      @map("pack_id")
  cardIds   Json      @map("card_ids")
  createdAt DateTime  @default(now()) @map("created_at")
  // Le joueur a vu tout le booster. Resté vide (page fermée, réseau coupé pendant l'ouverture),
  // le booster lui est reproposé : ses cartes sont déjà dans sa collection, il ne les a juste pas vues.
  seenAt    DateTime? @map("seen_at")

  // Relations
  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  set    CardSet?  @relation(fields: [setId], references: [id], onDelete: SetNull)
  pack   CardPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([playerId, id])
  @@index([playerId, seenAt])
  @@map("card_openings")
}

// Proposition d'échange entre deux joueurs (le MJ y compris)
model CardTrade {
  id         Int       @id @default(autoincrement())
  fromId     Int       @map("from_id")
  toId       Int       @map("to_id")
  // "attente", "acceptee", "refusee", "annulee", "caduque" (une carte a changé de mains entre-temps)
  status     String    @default("attente") @db.VarChar(10)
  message    String?   @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  // Relations
  from  Player          @relation("CardTradeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to    Player          @relation("CardTradeTo", fields: [toId], references: [id], onDelete: Cascade)
  items CardTradeItem[]

  @@index([toId, status])
  @@index([fromId, status])
  @@map("card_trades")
}

model CardTradeItem {
  id      Int     @id @default(autoincrement())
  tradeId Int     @map("trade_id")
  cardId  Int     @map("card_id")
  // Vrai : carte donnée par l'auteur de la proposition ; faux : carte demandée au destinataire
  offered Boolean

  // Relations
  trade CardTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  card  Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([tradeId, cardId])
  @@index([cardId])
  @@map("card_trade_items")
}

// Ligne unique (id = 1) : réglages du jeu de cartes, modifiables dans l'Espace MJ
model CardSettings {
  id              Int     @id @default(1)
  // Jeu ouvert aux joueurs. Fermé (par défaut), seul le MJ voit les cartes et peut les préparer.
  public          Boolean @default(false)
  // Un booster de plus toutes les `boosterMinutes`, jusqu'à `boosterMax` en réserve
  boosterMinutes  Int     @default(480) @map("booster_minutes")
  boosterMax      Int     @default(3) @map("booster_max")
  // Boosters offerts à l'ouverture de la réserve d'un nouveau joueur
  starterBoosters Int     @default(1) @map("starter_boosters")
  cardsPerBooster Int     @default(5) @map("cards_per_booster")
  // Rareté minimale de la dernière carte de chaque booster (1 = aucune garantie)
  guaranteed      Int     @default(3)
  // Chance (en %) qu'un booster soit un God Pack : une Unique au moins, le reste en Légendaire
  godPack         Float   @default(0) @map("god_pack") @db.Double
  // Poids de tirage par rareté, en pour cent : { "1": 62, "2": 25, … }
  rates           Json

  @@map("card_settings")
}
