// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Race {
  Humain
  Geant      @map("Géant")
  Eternelle  @map("Éternelle")
  Inconnu
  Dragon
  Ange
}

enum Country {
  Augeaime
  Inconnu
  Irisia
  Amari
  Mudan
  Edenia
  Celeste   @map("Céleste")
  Saxifra
}

enum ItemCategory {
  Casque
  Torse
  Gantelets
  Jambieres  @map("Jambières")
  Outil
  Arme
  Fiole
  Nourriture
  Munitions
  Important
  Autre
  Materiaux  @map("Matériaux")
  Animal
  Sac
}

enum FoodType {
  viandes
  boissons
  fruits
  rations
}

enum BadgeType {
  Artrish
  Yinva
  Guizamark
  Shizari
  Pestia
  Chronos
  Aqua
  Goliath
  Drii
  Lada
  Pura
}

enum SkillStatistic {
  PV
  QDF
  Endurance
  Maitrise   @map("Maîtrise")
  Force
  Defense    @map("Défense")
  Vitesse
  Precision  @map("Précision")
  Perception
  Furtivite  @map("Furtivité")
  Charisme
  Eloquence  @map("Éloquence")
  Intelligence
}

model Player {
  id           Int     @id @default(autoincrement())
  login        String  @unique @db.VarChar(255)
  password     String  @db.VarChar(255)
  role         Int     @db.Int
  team         Int     @db.Int
  characterId  Int?    @map("character_id")
  
  // Relations
  character    Character?     @relation(fields: [characterId], references: [id])
  itemsInPlayer ItemInPlayer[]
  badgesFusions BadgeFusion[]
  
  @@index([characterId], map: "players_character_id_index")
  @@map("players")
}

model Character {
  id          Int      @id @default(autoincrement())
  visibility  Int      @db.SmallInt
  name        String   @db.VarChar(255)
  flux        String?  @db.VarChar(255)
  dragon      String   @db.VarChar(255)
  title       String?  @db.VarChar(255)
  theme       String?  @db.VarChar(255)
  race        Race
  country     Country
  image       String   @db.VarChar(255)
  description String   @db.Text
  category    String   @db.VarChar(255)
  current     Int      @db.SmallInt
  
  // Relations
  players         Player[]
  statistics      Statistic?
  passives        Passive[]
  characterSkills CharacterSkill[]
  
  @@map("characters")
}

model Monster {
  id           Int     @id @default(autoincrement())
  visibility   Int     @db.SmallInt
  name         String  @db.VarChar(255)
  dragon       String  @db.VarChar(255)
  size         String  @db.VarChar(255)
  weight       String  @db.VarChar(255)
  dangerosity  Int     @db.Int
  image        String  @db.VarChar(255)
  effect       String  @db.Text
  description  String  @db.Text
  current      Int     @db.SmallInt
  
  @@map("monsters")
}

model Statistic {
  id           Int       @id @default(autoincrement())
  characterId  Int       @unique @map("character_id")
  qdf          Int       @db.Int
  pv           Int       @db.Int
  endurance    Int       @db.Int
  strength     Int       @db.Int
  maitrise     Int       @db.Int
  defense      Int       @db.Int
  vitesse      Int       @db.Int
  accuracy     Int       @db.Int
  perception   Int       @db.Int
  furtivite    Int       @db.Int
  charisme     Int       @db.Int
  eloquence    Int       @db.Int
  intelligence Int       @db.Int
  
  // Relations
  character    Character @relation(fields: [characterId], references: [id])
  
  @@map("statistics")
}

model Item {
  id          Int          @id @default(autoincrement())
  name        String       @default("Objet") @db.VarChar(255)
  category    ItemCategory
  rarity      Int          @db.Int
  weight      Int          @db.Int
  description String       @db.Text
  
  // Relations
  itemsInPlayer ItemInPlayer[]
  armors        Armor[]
  
  @@map("items")
}

model ItemInPlayer {
  id           Int      @id @default(autoincrement())
  itemId       Int      @map("item_id")
  playerId     Int      @map("player_id")
  quantity     Int      @default(1) @db.Int
  localisation String   @db.VarChar(255)
  
  // Relations
  item          Item            @relation(fields: [itemId], references: [id])
  player        Player          @relation(fields: [playerId], references: [id])
  armorInPlayer ArmorInPlayer[]
  foodsInBags   FoodInBag[]
  
  @@map("items_in_player")
}

model Armor {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(255)
  statistics String @db.VarChar(255)
  values     String @db.VarChar(255)
  itemId     Int    @map("item_id")
  
  // Relations
  item          Item            @relation(fields: [itemId], references: [id])
  armorInPlayer ArmorInPlayer[]
  
  @@map("armors")
}

model ArmorInPlayer {
  id               Int          @id @default(autoincrement())
  itemInPlayerId   Int          @map("item_in_player_id")
  armorId          Int          @map("armor_id")
  statistics       String       @db.VarChar(255)
  values           String       @db.VarChar(255)
  descriptionAdd   String       @map("description_add") @db.VarChar(255)
  notes            String       @db.Text
  
  // Relations
  itemInPlayer     ItemInPlayer @relation(fields: [itemInPlayerId], references: [id])
  armor            Armor        @relation(fields: [armorId], references: [id])
  
  @@map("armors_in_player")
}

model Food {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  weight Int      @db.Int
  type   FoodType
  price  Int      @db.Int
  
  // Relations
  foodsInBags FoodInBag[]
  
  @@map("foods")
}

model FoodInBag {
  id             Int          @id @default(autoincrement())
  itemInPlayerId Int          @map("item_in_player_id")
  foodId         Int          @map("food_id")
  quantity       Int          @default(1) @db.Int
  
  // Relations
  itemInPlayer   ItemInPlayer @relation(fields: [itemInPlayerId], references: [id])
  food           Food         @relation(fields: [foodId], references: [id])
  
  @@map("foods_in_bags")
}

model Badge {
  id          Int    @id @default(autoincrement())
  badges      String @db.VarChar(255)
  name        String @db.VarChar(255)
  description String @db.Text
  
  @@map("badges")
}

model BadgeFusion {
  id       Int       @id @default(autoincrement())
  badge1   BadgeType @map("badge_1")
  badge2   BadgeType @map("badge_2")
  playerId Int       @map("player_id")
  
  // Relations
  player   Player    @relation(fields: [playerId], references: [id])
  
  @@map("badges_fusions")
}

model Skill {
  id              Int              @id @default(autoincrement())
  statistics      SkillStatistic
  name            String           @db.VarChar(255)
  description     String           @db.Text
  level           Int              @db.Int
  characterSkills CharacterSkill[]
  
  @@map("skills")
}

model CharacterSkill {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  skillId     Int       @map("skill_id")
  level       Int       @default(1) @db.Int
  
  // Relations
  character   Character @relation(fields: [characterId], references: [id])
  skill       Skill     @relation(fields: [skillId], references: [id])
  
  @@unique([characterId, skillId], map: "character_skills_character_skill_unique")
  @@map("character_skills")
}

model Passive {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  statistics  String    @db.VarChar(255)
  maths       String    @db.VarChar(255)
  
  // Relations
  character   Character @relation(fields: [characterId], references: [id])
  
  @@map("passives")
}