# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env ne doit jamais être commité.

# ─────────────── Commun ───────────────

# Clé de signature des sessions : une longue chaîne aléatoire (32 caractères minimum), différente en production.
# Qui la connaît peut se connecter sur n'importe quel compte, MJ compris.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Adresse du site de lore. Si elle est renseignée, l'accueil affiche le lien « Histoires ».
PUBLIC_LORE_URL=""

# ─────────────── Compte MJ ───────────────
# Créé automatiquement au démarrage du conteneur s'il n'existe pas encore
# (ou à la main : node prisma/ensure-admin.mjs).
# Un compte déjà existant est promu MJ, sans que son mot de passe soit modifié.
ADMIN_LOGIN="MJ"
# 12 caractères minimum. À changer avant le premier démarrage.
ADMIN_PASSWORD=""
# Passer à true le temps d'un démarrage pour remplacer le mot de passe du compte par ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD=false

# ─────────────── Développement local (npm run dev) ───────────────

# Connexion MySQL utilisée par Prisma. Ignorée par Docker, qui construit la sienne ci-dessous.
DATABASE_URL="mysql://utilisateur:motdepasse@localhost:3306/lastfragment"

# ─────────────── Docker (docker compose up) ───────────────

# Port de la machine sur lequel le site répond.
APP_PORT=3010

# Adresse publique exacte du site, protocole compris. En production : https://mon-domaine.fr
# Si elle commence par https://, le cookie de session n'est envoyé qu'en HTTPS.
ORIGIN="http://localhost:3010"

# Derrière un reverse proxy uniquement : en-tête qui transmet l'IP réelle du visiteur
# (X-Forwarded-For pour Nginx/Traefik, CF-Connecting-IP pour Cloudflare). Laisser vide sinon :
# un en-tête non posé par le proxy pourrait être falsifié par le visiteur.
ADDRESS_HEADER=""
# Nombre de proxys de confiance devant le site (pour X-Forwarded-For).
XFF_DEPTH=1

# Base MySQL du conteneur. Éviter @ : / ? # dans les mots de passe, ils cassent l'URL de connexion.
MYSQL_DATABASE="lastfragment"
# Propriétaire du schéma : sert uniquement à la mise à jour de la base au démarrage (service migrate).
MYSQL_USER="lastfragment"
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
# Compte utilisé par le site : lecture et écriture des données seulement, sans DROP ni ALTER.
# Créé (et son mot de passe tenu à jour) automatiquement au démarrage. 16 caractères minimum.
MYSQL_APP_USER="lastfragment_app"
MYSQL_APP_PASSWORD=""

# Plafonds de ressources des conteneurs (facultatif).
# APP_CPUS=1.0
# APP_MEMORY=768M
# DB_CPUS=1.0
# DB_MEMORY=1G

# Développement local uniquement : ouvre aussi la base sur 127.0.0.1:DB_PORT (outil SQL, npm run dev).
# Ne pas mettre ces lignes en production.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# DB_PORT=3307
